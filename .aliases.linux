#!/usr/bin/env bash

# ============ Linux 专属别名 ============

# update：按发行版自动选择包管理器
if command -v apt &>/dev/null; then
    alias update='sudo apt update && sudo apt upgrade -y && sudo apt autoremove -y'
elif command -v dnf &>/dev/null; then
    alias update='sudo dnf upgrade -y && sudo dnf autoremove -y'
elif command -v pacman &>/dev/null; then
    alias update='sudo pacman -Syu'
fi

# IP addresses
alias localip="hostname -I | awk '{print \$1}'"
alias ips="ip -br addr show"

# Show active network interfaces
alias ifactive="ip -br link show | grep UP"

# Trim new lines and copy to clipboard（需要 xclip 或 xsel）
if command -v xclip &>/dev/null; then
    alias c="tr -d '\n' | xclip -selection clipboard"
elif command -v xsel &>/dev/null; then
    alias c="tr -d '\n' | xsel --clipboard --input"
fi

# Lock the screen (when going AFK)
alias afk="loginctl lock-session 2>/dev/null || xdg-screensaver lock"
